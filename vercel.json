{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "memory": 1024,
        "maxDuration": 10,
        "includeFiles": [
          "model/**/*",
          "templates/**/*",
          "static/**/*",
          "utils/**/*",
          "routes/**/*",
          "config.py",
          "app.py",
          "requirements.txt"
        ],
        "excludeFiles": [
          "**/venv/**",
          "**/.venv/**",
          "**/env/**",
          "**/ENV/**",
          "**/myenv/**",
          "**/__pycache__/**",
          "**/.git/**",
          "**/.vscode/**",
          "**/.idea/**",
          "**/node_modules/**",
          "data/**/*.csv",
          "data/**/*.xlsx",
          "data/**/*.json",
          "notebooks/**",
          "assets/**",
          "**/*.pyc",
          "**/*.pyo",
          "**/*.pyd",
          "**/*.so",
          "**/*.dll",
          "**/*.dylib",
          "**/*.log",
          "**/*.tmp",
          "**/*.temp",
          "**/.DS_Store",
          "**/Thumbs.db",
          "**/*.test.py",
          "**/test_*.py",
          "**/htmlcov/**",
          "**/.tox/**",
          "**/.pytest_cache/**",
          "**/.coverage",
          "**/coverage.xml",
          "**/*.cover",
          "**/build/**",
          "**/dist/**",
          "**/*.egg-info/**",
          "**/*.egg",
          "**/MANIFEST",
          "docs/**",
          "**/*.md",
          "!README.md"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  },
  "regions": [
    "iad1"
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
